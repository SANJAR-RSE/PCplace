# Telegram bot tokeni (@BotFather)
BOT_TOKEN=

# Backend API manzili (Node/NestJS)
API_URL=http://localhost:4000

# Backend'dagi BOT_INTERNAL_SECRET bilan bir xil bo'lishi kerak (auth/bot-login himoyasi)
BOT_INTERNAL_SECRET=

# Sessiyalar saqlanadigan lokal fayl (telegramId -> accessToken)
SESSIONS_FILE=sessions.json
